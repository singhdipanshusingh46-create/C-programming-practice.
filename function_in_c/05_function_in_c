/*Question:  
Write a C program to calculate the square root of a given number using
the sqrt() function from the math library.*/

#include<stdio.h>
#include<math.h>
int main(){
    int a;
    printf("enter a number:");
    scanf("%d",&a);
    
    int root=sqrt(a);
    printf(" the square root of  is=%d",root);
    return 0;
}
