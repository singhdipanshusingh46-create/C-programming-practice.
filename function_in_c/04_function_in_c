/*Question:  
Write a C program that prints a square number pattern using nested loops. 
Define a function minimum() to find the smaller of two integers, 
and use it to generate the pattern based on user input n.*/


#include<stdio.h>
int minimum(int a, int b){
    int min=a;
    if(b<a) min=b;
    return min;
    
}int main(){
    int n;
    printf("enter a number of lines:");
    scanf("%d",&n);
    int min=0;
    for(int i=1; i<=2*n-1; i++){
        for(int j=1; j<=2*n-1; j++){
            int a=i;
            if(i>n) a=2*n-i;
            int b=j;
            if(b>n) b=2*n-j;
            min=minimum(a,b);
            printf("%d",n+1-min);
        }
        printf("\n");
    }
    return 0;
}
